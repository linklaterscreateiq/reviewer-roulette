{
  "name": "@createiq/reviewer-roulette",
  "version": "1.0.7",
  "description": "Randomly select reviewers for your merge request from a configuration file with Slack integration for holiday detection",
  "main": "./dist/roulette.js",
  "bin": {
    "reviewer-roulette": "dist/roulette.js"
  },
  "scripts": {
    "build": "npm run tsc",
    "tsc": "tsc -p tsconfig.json",
    "bundle": "tsup",
    "smoke": "npm run bundle && node scripts/smoke-test.mjs",
    "upload": "npm run bundle && npm publish --access public",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write ."
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "Linklaters CreateiQ",
  "license": "MIT",
  "dependencies": {
    "@slack/web-api": "8.0.0",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "24.13.3",
    "tsup": "^8.5.1",
    "typescript": "7.0.2"
  }
}
